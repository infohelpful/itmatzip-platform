<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <?define ProductName = "ItMatZip Agent" ?>
  <?define ProductVersion = "1.7.29.0" ?>
  <?define Manufacturer = "ItMatZip" ?>
  <?define UpgradeCode = "A1B2C3D4-E5F6-7890-ABCD-EF1234567890" ?>

  <Product Id="*"
           Name="$(var.ProductName)"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="$(var.Manufacturer)"
           UpgradeCode="$(var.UpgradeCode)">
    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"
             Description="$(var.ProductName) tray application"
             Comments="Go controller + Python AI worker (tray mode)" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of $(var.ProductName) is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="$(var.ProductName)" Level="1">
      <ComponentGroupRef Id="StagingComponents" />
      <ComponentGroupRef Id="DataFolderComponents" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="itmatzip-agent" />
      </Directory>
      <Directory Id="CommonAppDataFolder">
        <Directory Id="DATAFOLDER" Name="itmatzip-agent">
          <Directory Id="BINFOLDER" Name="bin" />
          <Directory Id="LOGSFOLDER" Name="logs" />
        </Directory>
      </Directory>
    </Directory>

    <ComponentGroup Id="DataFolderComponents">
      <Component Id="DataFolderPermissions" Guid="B8E4F2A1-3C5D-4E6F-9012-3456789ABCDE" Directory="LOGSFOLDER">
        <CreateFolder />
        <RegistryValue Root="HKLM"
                       Key="Software\ItMatZip\Agent"
                       Name="DataRoot"
                       Type="string"
                       Value="[DATAFOLDER]"
                       KeyPath="yes" />
      </Component>
      <Component Id="BinFolder" Guid="D4E5F6A7-B8C9-0123-DEF0-456789012345" Directory="BINFOLDER">
        <CreateFolder />
        <RegistryValue Root="HKLM"
                       Key="Software\ItMatZip\Agent"
                       Name="BinDir"
                       Type="string"
                       Value="[BINFOLDER]"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- WixQuietExec64: cmd.exe /c 없이 콘솔 창 없이 icacls 실행 -->
    <CustomAction Id="SetGrantDataFolderPermissions"
                  Property="GrantDataFolderPermissions"
                  Value="&quot;[System64Folder]icacls.exe&quot; &quot;[DATAFOLDER].&quot; /grant *S-1-5-32-545:(OI)(CI)M /T /Q"
                  Execute="immediate" />
    <CustomAction Id="GrantDataFolderPermissions"
                  BinaryKey="WixCA"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="SetGrantEngineSitePackagesPermissions"
                  Property="GrantEngineSitePackagesPermissions"
                  Value="&quot;[System64Folder]icacls.exe&quot; &quot;[INSTALLFOLDER]engine\Lib\site-packages&quot; /grant *S-1-5-32-545:(OI)(CI)M /T /Q"
                  Execute="immediate" />
    <CustomAction Id="GrantEngineSitePackagesPermissions"
                  BinaryKey="WixCA"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="RegisterTrayAutostart"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]itmatzip-agent.exe&quot; --install"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <CustomAction Id="StartTrayIcon"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]itmatzip-agent.exe&quot; --tray"
                  Execute="commit"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <!-- Files held open by a process (python312.zip under a running python.exe, or a tray that taskkill
         could not end) are replaced/deleted only at the next reboot, and a queued delete of the old file
         then wipes the newly installed one (1.7.1 -> reboot left engine\python312.zip missing and every
         tool failed). End every process started from the install folder and wait (up to ~10s) until they
         are gone, before InstallValidate / RemoveExistingProducts touch any file. Runs in the elevated
         msiexec client (the auto-updater and the UAC prompt both elevate). Target is limited to 255
         characters (ICE03), hence the short aliases. A deferred action cannot be used here: it may not
         precede RemoveExistingProducts (error 2613). -->
    <CustomAction Id="SetStopTrayOnUpgrade"
                  Property="WixQuietExec64CmdLine"
                  Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoP -NonI -C &quot;$d='[INSTALLFOLDER]';1..50|%{$p=gcim Win32_Process|?{$_.ExecutablePath -like ($d+'*')};if(!$p){break};$p|%{spps $_.ProcessId -F -EA 0};sleep -M 200}&quot;"
                  Execute="immediate" />
    <CustomAction Id="StopTrayOnUpgrade"
                  BinaryKey="WixCA"
                  DllEntry="WixQuietExec64"
                  Execute="immediate"
                  Return="ignore" />

    <CustomAction Id="SetStopTrayOnRemove"
                  Property="StopTrayOnRemove"
                  Value="&quot;[System64Folder]taskkill.exe&quot; /F /T /IM itmatzip-agent.exe"
                  Execute="immediate" />
    <CustomAction Id="StopTrayOnRemove"
                  BinaryKey="WixCA"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="UnregisterTrayAutostart"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]itmatzip-agent.exe&quot; --uninstall"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="SetStopTrayOnUpgrade" Before="StopTrayOnUpgrade">NOT REMOVE</Custom>
      <Custom Action="StopTrayOnUpgrade" Before="InstallValidate">NOT REMOVE</Custom>
      <Custom Action="SetGrantDataFolderPermissions" Before="GrantDataFolderPermissions">NOT REMOVE</Custom>
      <Custom Action="GrantDataFolderPermissions" After="InstallFiles">NOT REMOVE</Custom>
      <Custom Action="SetGrantEngineSitePackagesPermissions" Before="GrantEngineSitePackagesPermissions">NOT REMOVE</Custom>
      <Custom Action="GrantEngineSitePackagesPermissions" After="GrantDataFolderPermissions">NOT REMOVE</Custom>
      <Custom Action="RegisterTrayAutostart" After="GrantEngineSitePackagesPermissions">NOT REMOVE</Custom>
      <Custom Action="StartTrayIcon" After="RegisterTrayAutostart">NOT REMOVE</Custom>
      <Custom Action="SetStopTrayOnRemove" Before="StopTrayOnRemove">REMOVE="ALL"</Custom>
      <Custom Action="StopTrayOnRemove" Before="UnregisterTrayAutostart">REMOVE="ALL"</Custom>
      <Custom Action="UnregisterTrayAutostart" Before="RemoveFiles">REMOVE="ALL"</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
