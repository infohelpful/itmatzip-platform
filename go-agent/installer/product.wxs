<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <?define ProductName = "ItMatZip Agent" ?>
  <?define ProductVersion = "1.1.9.0" ?>
  <?define Manufacturer = "ItMatZip" ?>
  <?define UpgradeCode = "A1B2C3D4-E5F6-7890-ABCD-EF1234567890" ?>

  <Product Id="*"
           Name="$(var.ProductName)"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="$(var.Manufacturer)"
           UpgradeCode="$(var.UpgradeCode)">
    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"
             Description="$(var.ProductName) local service"
             Comments="Go controller + Python AI worker" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of $(var.ProductName) is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="$(var.ProductName)" Level="1">
      <ComponentGroupRef Id="StagingComponents" />
      <ComponentGroupRef Id="DataFolderComponents" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="itmatzip-agent" />
      </Directory>
      <Directory Id="CommonAppDataFolder">
        <Directory Id="DATAFOLDER" Name="itmatzip-agent">
          <Directory Id="BINFOLDER" Name="bin" />
          <Directory Id="LOGSFOLDER" Name="logs" />
        </Directory>
      </Directory>
    </Directory>

    <ComponentGroup Id="DataFolderComponents">
      <Component Id="DataFolderPermissions" Guid="B8E4F2A1-3C5D-4E6F-9012-3456789ABCDE" Directory="LOGSFOLDER">
        <CreateFolder />
        <RegistryValue Root="HKLM"
                       Key="Software\ItMatZip\Agent"
                       Name="DataRoot"
                       Type="string"
                       Value="[DATAFOLDER]"
                       KeyPath="yes" />
      </Component>
      <Component Id="BinFolder" Guid="D4E5F6A7-B8C9-0123-DEF0-456789012345" Directory="BINFOLDER">
        <CreateFolder />
        <RegistryValue Root="HKLM"
                       Key="Software\ItMatZip\Agent"
                       Name="BinDir"
                       Type="string"
                       Value="[BINFOLDER]"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <CustomAction Id="InstallService"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]itmatzip-agent.exe&quot; --install"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!-- 일반 사용자가 트레이에서 서비스 시작/중지 (SYSTEM 설치 시 sc sdset) -->
    <CustomAction Id="GrantServiceUserControl"
                  Directory="INSTALLFOLDER"
                  ExeCommand="cmd.exe /c sc sdset ItMatZipAgent &quot;D:(A;;CCLCSWRPWPDTLOCRRC;;;SY)(A;;CCDCLCSWRPWPDTLOCRRC;;;BA)(A;;RPWP;;;AU)(A;;CCLCSWRPWPDTLOCRRC;;;IU)&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="StartAgentService"
                  Directory="INSTALLFOLDER"
                  ExeCommand="cmd.exe /c sc start ItMatZipAgent"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- 설치 직후 트레이만 표시 (서비스는 InstallService에서 이미 시작) -->
    <CustomAction Id="StartTrayIcon"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]itmatzip-agent.exe&quot; --tray"
                  Execute="commit"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <CustomAction Id="StopAgentServiceOnUpgrade"
                  Directory="INSTALLFOLDER"
                  ExeCommand="cmd.exe /c sc stop ItMatZipAgent"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="StopAgentServiceOnRemove"
                  Directory="INSTALLFOLDER"
                  ExeCommand="cmd.exe /c sc stop ItMatZipAgent"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="UninstallService"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]itmatzip-agent.exe&quot; --uninstall"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="StopAgentServiceOnUpgrade" Before="InstallFiles">(WIX_UPGRADE_DETECTED) AND NOT REMOVE</Custom>
      <Custom Action="InstallService" After="InstallFiles">NOT REMOVE</Custom>
      <Custom Action="GrantServiceUserControl" After="InstallService">NOT REMOVE</Custom>
      <Custom Action="StartAgentService" After="GrantServiceUserControl">NOT REMOVE</Custom>
      <Custom Action="StartTrayIcon" After="StartAgentService">NOT REMOVE</Custom>
      <Custom Action="StopAgentServiceOnRemove" Before="UninstallService">REMOVE="ALL"</Custom>
      <Custom Action="UninstallService" Before="RemoveFiles">REMOVE="ALL"</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
